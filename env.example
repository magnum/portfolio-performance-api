# Required: clients send this as X-Api-Key, Authorization: Bearer, or ?apikey=
API_KEY=change-me

# Password of the encrypted .portfolio file
PORTFOLIO_PASSWORD=your-portfolio-password

# Google Drive file (id from the share URL, or the full URL)
GOOGLE_DRIVE_FILE_ID=1abc...xyz

# Service account: either the JSON contents or a path to the key file
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cache lifetime in minutes (default 15). Pass ?nocache to force a refresh.
CACHE_TTL_MINUTES=15

# Optional local file (used when Drive is not configured, e.g. tests)
# PORTFOLIO_FILE=./tmp/portfolio.portfolio

# PORT=9292
# API_KEY_HEADER=X-Api-Key
# INCLUDE_RETIRED=true

# Fineco XLS/XLSX import: skip preamble rows before the table (header is on row 13)
IMPORT_FINECO_XLS_SKIP_LINES=13
