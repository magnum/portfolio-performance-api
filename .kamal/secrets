# Secrets referenced by config/deploy.yml.
# Safe to commit: values come from the environment or a command, not from this file.
#
# Before deploy, load your local .env:
#   set -a && source .env && set +a

API_KEY=$API_KEY
PORTFOLIO_PASSWORD=$PORTFOLIO_PASSWORD
PORTFOLIO_GOOGLE_DRIVE_FILE_ID=$PORTFOLIO_GOOGLE_DRIVE_FILE_ID
# Base64 so Docker/Kamal env files cannot mangle the PEM newlines.
GOOGLE_SERVICE_ACCOUNT_JSON=$(ruby -rbase64 -e 'print Base64.strict_encode64(ENV.fetch("GOOGLE_SERVICE_ACCOUNT_JSON"))')
